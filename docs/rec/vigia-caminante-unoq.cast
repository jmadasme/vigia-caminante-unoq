[52.966, "o", "\u001b[90m┌─ vision.py · _detectar_movimiento() ──────────────────────────────────────────────────────────────────\u001b[0m\n"]
[52.966, "o", "\u001b[90m 276\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_detectar_movimiento\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[53.021, "o", "\u001b[90m 277\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mself\u001b[39;49;00m, gris: np.ndarray, escala: \u001b[96mfloat\u001b[39;49;00m, forma_original: Tuple[\u001b[96mint\u001b[39;49;00m, ...]\u001b[90m\u001b[39;49;00m\n"]
[53.076, "o", "\u001b[90m 278\u001b[0m\u001b[90m │ \u001b[0m    ) -> List[BBox]:\u001b[90m\u001b[39;49;00m\n"]
[53.131, "o", "\u001b[90m 279\u001b[0m\u001b[90m │ \u001b[0m        mascara = \u001b[96mself\u001b[39;49;00m._bg.apply(gris)\u001b[90m\u001b[39;49;00m\n"]
[53.186, "o", "\u001b[90m 280\u001b[0m\u001b[90m │ \u001b[0m        _, binaria = cv2.threshold(mascara, \u001b[94m200\u001b[39;49;00m, \u001b[94m255\u001b[39;49;00m, cv2.THRESH_BINARY)\u001b[90m\u001b[39;49;00m\n"]
[53.241, "o", "\u001b[90m 281\u001b[0m\u001b[90m │ \u001b[0m        binaria = cv2.morphologyEx(binaria, cv2.MORPH_CLOSE, \u001b[96mself\u001b[39;49;00m._kernel_cierre)\u001b[90m\u001b[39;49;00m\n"]
[53.296, "o", "\u001b[90m 282\u001b[0m\u001b[90m │ \u001b[0m        binaria = cv2.morphologyEx(binaria, cv2.MORPH_OPEN, \u001b[96mself\u001b[39;49;00m._kernel_apertura)\u001b[90m\u001b[39;49;00m\n"]
[53.351, "o", "\u001b[90m 283\u001b[0m\u001b[90m │ \u001b[0m        contornos, _ = cv2.findContours(binaria, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\u001b[90m\u001b[39;49;00m\n"]
[53.406, "o", "\u001b[90m 284\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m._filtrar_detecciones(contornos, escala, forma_original)\u001b[90m\u001b[39;49;00m\n"]
