[140.69, "o", "\u001b[90m┌─ camara.py · _LectorMjpeg.leer() ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[140.69, "o", "\u001b[90m 177\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m largo <= \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[140.745, "o", "\u001b[90m 178\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# I-007: sin Content-Length se acumulan chunks (hasta 2 MB)\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[140.8, "o", "\u001b[90m 179\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# hasta encontrar el boundary o vencer el timeout, en vez de\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[140.855, "o", "\u001b[90m 180\u001b[0m\u001b[90m │ \u001b[0m                \u001b[90m# reconectar cuando el frame llega partido en varios ``read``.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[140.91, "o", "\u001b[90m 181\u001b[0m\u001b[90m │ \u001b[0m                limite = time.monotonic() + \u001b[96mmax\u001b[39;49;00m(\u001b[94m0.5\u001b[39;49;00m, \u001b[96mself\u001b[39;49;00m.timeout_s)\u001b[90m\u001b[39;49;00m\n"]
[140.965, "o", "\u001b[90m 182\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mwhile\u001b[39;49;00m \u001b[94mTrue\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[141.02, "o", "\u001b[90m 183\u001b[0m\u001b[90m │ \u001b[0m                    fin = \u001b[96mself\u001b[39;49;00m._resto.find(\u001b[33mb\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m\\r\u001b[39;49;00m\u001b[33m\\n\u001b[39;49;00m\u001b[33m--\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[141.075, "o", "\u001b[90m 184\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94mif\u001b[39;49;00m fin >= \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[141.13, "o", "\u001b[90m 185\u001b[0m\u001b[90m │ \u001b[0m                        \u001b[94mbreak\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
