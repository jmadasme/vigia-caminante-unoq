[80.73, "o", "\u001b[90m┌─ vision.py · _score_individual() ─────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[80.73, "o", "\u001b[90m 326\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m obj.area_rel >= \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33marea_maxima_rel\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m):\u001b[90m\u001b[39;49;00m\n"]
[80.785, "o", "\u001b[90m 327\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m \u001b[94m1.0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[80.84, "o", "\u001b[90m 328\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[80.895, "o", "\u001b[90m 329\u001b[0m\u001b[90m │ \u001b[0m        nx, ny, nw, nh = obj.bbox_norm\u001b[90m\u001b[39;49;00m\n"]
[80.95, "o", "\u001b[90m 330\u001b[0m\u001b[90m │ \u001b[0m        centro_y = ny + nh / \u001b[94m2.0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[81.005, "o", "\u001b[90m 331\u001b[0m\u001b[90m │ \u001b[0m        y_min = \u001b[96mself\u001b[39;49;00m.config.corredor_y_min\u001b[90m\u001b[39;49;00m\n"]
[81.06, "o", "\u001b[90m 332\u001b[0m\u001b[90m │ \u001b[0m        rango = \u001b[96mmax\u001b[39;49;00m(\u001b[94m1e-6\u001b[39;49;00m, \u001b[94m1.0\u001b[39;49;00m - y_min)\u001b[90m\u001b[39;49;00m\n"]
[81.115, "o", "\u001b[90m 333\u001b[0m\u001b[90m │ \u001b[0m        w_cercania = _clamp((centro_y - y_min) / rango) ** \u001b[94m2\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[81.17, "o", "\u001b[90m 334\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[81.225, "o", "\u001b[90m 335\u001b[0m\u001b[90m │ \u001b[0m        vel_critica = \u001b[96mmax\u001b[39;49;00m(\u001b[94m1e-6\u001b[39;49;00m, \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mvel_y_critica\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[81.28, "o", "\u001b[90m 336\u001b[0m\u001b[90m │ \u001b[0m        w_vel = _sigmoide((obj.velocidad_y - vel_critica / \u001b[94m2.0\u001b[39;49;00m) / \u001b[96mmax\u001b[39;49;00m(\u001b[94m1e-6\u001b[39;49;00m, vel_critica / \u001b[94m4.0\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[81.335, "o", "\u001b[90m 337\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[81.39, "o", "\u001b[90m 338\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# I-002: defensa en profundidad contra loom_critico <= 0 vía API.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[81.445, "o", "\u001b[90m 339\u001b[0m\u001b[90m │ \u001b[0m        loom_critico = \u001b[96mmax\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mloom_critico\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m), \u001b[94m1e-6\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[81.5, "o", "\u001b[90m 340\u001b[0m\u001b[90m │ \u001b[0m        w_loom = _clamp(\u001b[96mmax\u001b[39;49;00m(\u001b[94m0.0\u001b[39;49;00m, obj.crecimiento_area_s) / loom_critico)\u001b[90m\u001b[39;49;00m\n"]
[81.555, "o", "\u001b[90m 341\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[81.61, "o", "\u001b[90m 342\u001b[0m\u001b[90m │ \u001b[0m        a_peq = \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33marea_pequena\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[81.665, "o", "\u001b[90m 343\u001b[0m\u001b[90m │ \u001b[0m        a_gran = \u001b[96mmax\u001b[39;49;00m(a_peq + \u001b[94m1e-6\u001b[39;49;00m, \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33marea_grande\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[81.72, "o", "\u001b[90m 344\u001b[0m\u001b[90m │ \u001b[0m        w_area = _sigmoide((obj.area_rel - (a_peq + a_gran) / \u001b[94m2.0\u001b[39;49;00m) / \u001b[96mmax\u001b[39;49;00m(\u001b[94m1e-6\u001b[39;49;00m, (a_gran - a_peq\u001b[04m\u001b[91m…\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[81.775, "o", "\u001b[90m 345\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[81.83, "o", "\u001b[90m 346\u001b[0m\u001b[90m │ \u001b[0m        ttc_critico = \u001b[96mmax\u001b[39;49;00m(\u001b[94m1e-3\u001b[39;49;00m, \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mttc_critico\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[81.885, "o", "\u001b[90m 347\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m math.isinf(obj.ttc) \u001b[95mor\u001b[39;49;00m obj.ttc \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[81.94, "o", "\u001b[90m 348\u001b[0m\u001b[90m │ \u001b[0m            w_ttc = \u001b[94m0.0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[81.995, "o", "\u001b[90m 349\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94melse\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[82.05, "o", "\u001b[90m 350\u001b[0m\u001b[90m │ \u001b[0m            w_ttc = math.exp(-\u001b[96mmax\u001b[39;49;00m(\u001b[94m0.0\u001b[39;49;00m, obj.ttc) / ttc_critico)\u001b[90m\u001b[39;49;00m\n"]
[82.105, "o", "\u001b[90m 351\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[82.16, "o", "\u001b[90m 352\u001b[0m\u001b[90m │ \u001b[0m        score = (\u001b[90m\u001b[39;49;00m\n"]
[82.215, "o", "\u001b[90m 353\u001b[0m\u001b[90m │ \u001b[0m            w_cercania * \u001b[96mself\u001b[39;49;00m.config.peso_cercania\u001b[90m\u001b[39;49;00m\n"]
[82.27, "o", "\u001b[90m 354\u001b[0m\u001b[90m │ \u001b[0m            + w_vel * \u001b[96mself\u001b[39;49;00m.config.peso_velocidad\u001b[90m\u001b[39;49;00m\n"]
[82.325, "o", "\u001b[90m 355\u001b[0m\u001b[90m │ \u001b[0m            + w_loom * \u001b[96mself\u001b[39;49;00m.config.peso_looming\u001b[90m\u001b[39;49;00m\n"]
[82.38, "o", "\u001b[90m 356\u001b[0m\u001b[90m │ \u001b[0m            + w_area * \u001b[96mself\u001b[39;49;00m.config.peso_area\u001b[90m\u001b[39;49;00m\n"]
[82.435, "o", "\u001b[90m 357\u001b[0m\u001b[90m │ \u001b[0m            + w_ttc * \u001b[96mself\u001b[39;49;00m.config.peso_ttc\u001b[90m\u001b[39;49;00m\n"]
[82.49, "o", "\u001b[90m 358\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
