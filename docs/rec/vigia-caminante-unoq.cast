[96.211, "o", "\u001b[90m 362\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_histeresis\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, score: \u001b[96mfloat\u001b[39;49;00m, nivel_actual: \u001b[96mstr\u001b[39;49;00m, t_en_nivel_ms: \u001b[96mfloat\u001b[39;49;00m) -> \u001b[96mstr\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[96.266, "o", "\u001b[90m 363\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[33m\"\"\"Nivel resultante para un score, con histéresis y tiempo mínimo en rojo.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[96.321, "o", "\u001b[90m 364\u001b[0m\u001b[90m │ \u001b[0m        rojo_in = \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mumbral_rojo_in\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[96.376, "o", "\u001b[90m 365\u001b[0m\u001b[90m │ \u001b[0m        rojo_out = \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mumbral_rojo_out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[96.431, "o", "\u001b[90m 366\u001b[0m\u001b[90m │ \u001b[0m        ambar_in = \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mumbral_ambar_in\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[96.486, "o", "\u001b[90m 367\u001b[0m\u001b[90m │ \u001b[0m        ambar_out = \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mumbral_ambar_out\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[96.541, "o", "\u001b[90m 368\u001b[0m\u001b[90m │ \u001b[0m        min_rojo = \u001b[96mself\u001b[39;49;00m._p(\u001b[33m\"\u001b[39;49;00m\u001b[33mmin_tiempo_rojo_ms\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
