[96.761, "o", "\u001b[90m 372\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m nivel_actual == \u001b[33m\"\u001b[39;49;00m\u001b[33mRED\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m (score > rojo_out \u001b[95mor\u001b[39;49;00m t_en_nivel_ms < min_rojo):\u001b[90m\u001b[39;49;00m\n"]
