[126.138, "o", "\u001b[90m┌─ estado.py · reemplazar_estado_si() ──────────────────────────────────────────────────────────────────\u001b[0m\n"]
[126.138, "o", "\u001b[90m 227\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mreemplazar_estado_si\u001b[39;49;00m(\u001b[90m\u001b[39;49;00m\n"]
[126.193, "o", "\u001b[90m 228\u001b[0m\u001b[90m │ \u001b[0m        \u001b[96mself\u001b[39;49;00m, funcion: Callable[[EstadoFrame], Optional[EstadoFrame]]\u001b[90m\u001b[39;49;00m\n"]
[126.248, "o", "\u001b[90m 229\u001b[0m\u001b[90m │ \u001b[0m    ) -> Optional[EstadoFrame]:\u001b[90m\u001b[39;49;00m\n"]
[126.303, "o", "\u001b[90m 230\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33mActualiza el estado de forma atómica si ``funcion(actual)`` no es None.\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[126.358, "o", "\u001b[90m 231\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[126.413, "o", "\u001b[90m 232\u001b[0m\u001b[90m │ \u001b[0m        I-\u001b[94m011\u001b[39;49;00m: permite que el watchdog decida y escriba dentro \u001b[94mdel\u001b[39;49;00m mismo\u001b[90m\u001b[39;49;00m\n"]
[126.468, "o", "\u001b[90m 233\u001b[0m\u001b[90m │ \u001b[0m        candado, sin lectura-modificación-escritura que pueda pisar un estado\u001b[90m\u001b[39;49;00m\n"]
[126.523, "o", "\u001b[90m 234\u001b[0m\u001b[90m │ \u001b[0m        recién publicado por el hilo de visión. Devuelve el estado nuevo o\u001b[90m\u001b[39;49;00m\n"]
[126.578, "o", "\u001b[90m 235\u001b[0m\u001b[90m │ \u001b[0m        \u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[94mNone\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m\u001b[04m\u001b[91m`\u001b[39;49;00m si no hubo cambio.\u001b[90m\u001b[39;49;00m\n"]
[126.633, "o", "\u001b[90m 236\u001b[0m\u001b[90m │ \u001b[0m        \u001b[33m\"\"\"\u001b[39;49;00m\u001b[33m\u001b[39;49;00m\n"]
[126.688, "o", "\u001b[90m 237\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mwith\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m._lock_estado:\u001b[90m\u001b[39;49;00m\n"]
[126.743, "o", "\u001b[90m 238\u001b[0m\u001b[90m │ \u001b[0m            nuevo = funcion(\u001b[96mself\u001b[39;49;00m._estado)\u001b[90m\u001b[39;49;00m\n"]
[126.798, "o", "\u001b[90m 239\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m nuevo \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[126.853, "o", "\u001b[90m 240\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mreturn\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[126.908, "o", "\u001b[90m 241\u001b[0m\u001b[90m │ \u001b[0m            \u001b[96mself\u001b[39;49;00m._estado = nuevo\u001b[90m\u001b[39;49;00m\n"]
[126.963, "o", "\u001b[90m 242\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m._estado.copia()\u001b[90m\u001b[39;49;00m\n"]
