[25.937, "o", "\u001b[90m 266\u001b[0m\u001b[90m │ \u001b[0m        escala = ancho / \u001b[96mfloat\u001b[39;49;00m(\u001b[96mmax\u001b[39;49;00m(\u001b[94m1\u001b[39;49;00m, ancho0))\u001b[90m\u001b[39;49;00m\n"]
[25.992, "o", "\u001b[90m 267\u001b[0m\u001b[90m │ \u001b[0m        alto = \u001b[96mmax\u001b[39;49;00m(\u001b[94m2\u001b[39;49;00m, \u001b[96mint\u001b[39;49;00m(\u001b[96mround\u001b[39;49;00m(alto0 * escala)))\u001b[90m\u001b[39;49;00m\n"]
[26.047, "o", "\u001b[90m 268\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# INTER_AREA es 5x más lento en el Cortex-A53 de la placa (80 ms frente\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[26.102, "o", "\u001b[90m 269\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# a 14 ms); el desenfoque posterior compensa el aliasing de INTER_LINEAR.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[26.157, "o", "\u001b[90m 270\u001b[0m\u001b[90m │ \u001b[0m        pequeno = cv2.resize(frame, (ancho, alto), interpolation=cv2.INTER_LINEAR)\u001b[90m\u001b[39;49;00m\n"]
[26.212, "o", "\u001b[90m 271\u001b[0m\u001b[90m │ \u001b[0m        gris = cv2.cvtColor(pequeno, cv2.COLOR_BGR2GRAY)\u001b[90m\u001b[39;49;00m\n"]
[26.267, "o", "\u001b[90m 272\u001b[0m\u001b[90m │ \u001b[0m        gris = cv2.GaussianBlur(gris, (\u001b[94m5\u001b[39;49;00m, \u001b[94m5\u001b[39;49;00m), \u001b[94m0\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[26.322, "o", "\u001b[90m 273\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m gris, escala\u001b[90m\u001b[39;49;00m\n"]
