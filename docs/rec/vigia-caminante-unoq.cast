[156.431, "o", "\u001b[90m 133\u001b[0m\u001b[90m │ \u001b[0m                \u001b[96mself\u001b[39;49;00m._serve_static(\u001b[33m\"\u001b[39;49;00m\u001b[33mindex.html\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
